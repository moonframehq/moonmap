-- Moonmap's look: Apple Maps' quiet sidebar, white floating controls with
-- soft shadows, and Maps' own system blue. Map-specific classes start with
-- `map-` or `side-` so Moonframe's component styles never leak in.
local CARD_SHADOW = { { y = 1, blur = 3, color = "#0000001f" }, { y = 4, blur = 14, color = "#00000014" } }

